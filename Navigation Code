def set_motors(left_speed, right_speed):
    # Left motor
    if left_speed >= 0:
        dc_motor1.forward(left_speed)
    else:
        dc_motor1.backward(abs(left_speed))
    
    # Right motor
    if right_speed >= 0:
        dc_motor2.forward(right_speed)
    else:
        dc_motor2.backward(abs(right_speed))

